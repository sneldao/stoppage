# Copy to .env.local and fill in.
#
# NOTE (lesson from pir8): program IDs are deliberately NOT env vars here.
# They live in packages/sdk/src/programIds.ts, generated from keys/ by
# scripts/sync-ids.js and enforced by `npm run check:ids`. One source of
# truth, zero copy-paste drift.

# Helius RPC (https URL; the WebSocket URL is derived from it)
NEXT_PUBLIC_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Alchemy RPC — sponsored fallback in the devnet chain (lib/rpc.ts):
# Helius → Alchemy → public gateway. Optional; leave unset to skip.
NEXT_PUBLIC_ALCHEMY_RPC_URL=https://solana-devnet.g.alchemy.com/v2/YOUR_API_KEY

# Public app URL (used for wallet app-identity and Blinks icons)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side Solana RPC for public board scans.
# Do not prefix with NEXT_PUBLIC_; this must stay server-only.
# Fallback chain when unset: NEXT_PUBLIC_HELIUS_RPC_URL (above), then the
# public devnet gateway (rate-limited; responses are flagged degraded).
SHYFT_API_KEY=YOUR_SHYFT_API_KEY

# TxLINE API credentials. Prefer env vars in deployment; local dev can also
# fall back to the gitignored repo-root .txline-credentials.json generated by
# `npx tsx scripts/subscribe-txline.ts`.
# WARNING: all-or-nothing — setting any one of these locally shadows the
# auto-renewed file and 401s when the pasted values go stale. Leave all
# three unset for local dev unless you are deliberately overriding.
TXLINE_NETWORK=devnet
TXLINE_JWT=replace-me
TXLINE_API_TOKEN=replace-me

# Runware (https://runware.ai) — campaign stills and video. Scripts and
# server routes only. Do not prefix with NEXT_PUBLIC_; generated assets
# are committed under apps/web/public/campaign/, the key never ships.
RUNWARE_API_KEY=YOUR_RUNWARE_API_KEY

# Optional: Formspree form ID for the /keystone "notify me" lead capture.
# Defaults to the keystone form (mppalqoo) in code; set a different ID here
# only to point a future campaign at another form. Leave the placeholder
# value to render the calendar-file fallback CTA instead of the form.
NEXT_PUBLIC_FORMSPREE_ID=mppalqoo

# TypeSafe Jev (https://docs.typesafe.ai) — advisory live reads only.
# Server-only; the /api/jev-mind route calls System One with 4 parallel
# questions. Unset = deterministic heuristic fallback labeled honestly.
# Never gates market creation, betting, or settlement.
TYPESAFE_API_KEY=
# Vercel AI Gateway (free promo till 2026-09-25) — PRIMARY Jev path via
# `typesafe-ai/jev` (`experimental_evaluate`, zero data retention).
# Server-only. Precedence: gateway first, TYPESAFE_API_KEY direct second,
# heuristic last. After the promo ends, unset this to fall back to direct.
AI_GATEWAY_API_KEY=
