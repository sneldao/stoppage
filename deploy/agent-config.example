# Keep this file on the VPS as /home/linuxuser/stoppage/.env.agent (mode 600).
TXLINE_NETWORK=devnet
TXLINE_JWT=replace-me
TXLINE_API_TOKEN=replace-me
SOLANA_KEYPAIR_PATH=/home/linuxuser/stoppage/secrets/agent-devnet.json
MATCH_EVENTS_PATH=/home/linuxuser/stoppage/.runtime/match-events.ndjson
AGENT_HTTP_PORT=18766

# Optional: comma-separated TxLINE competition IDs (see Competition enum
# in packages/txline). Empty = all fixtures in the snapshot.
# MLS=33, EPL=8, Friendlies=430. MLS + EPL covered from Aug 21:
# TXLINE_COMPETITIONS=33,8
TXLINE_COMPETITIONS=33,8

# OpenTelemetry → SigNoz (optional; see docs/OBSERVABILITY.md)
# Install SigNoz on the VPS: ./scripts/install-signoz-vps.sh
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=stoppage-agent
# OTEL_METRIC_EXPORT_INTERVAL_MS=10000

# UsePod advisory (optional; AnsemHack Inference Markets track — see
# docs/hackathons.md §3). At match_started the agent pays per call via
# x402 (SOL on MAINNET — the agent keypair needs a small mainnet SOL
# balance) for a template-selection advisory. Non-gating: any failure
# falls back to DEFAULT_TEMPLATES.
# USEPOD_ADVISORY=1
# USEPOD_MODEL=gpt-4o-mini
# USEPOD_PAYMENT_RPC=https://api.mainnet-beta.solana.com
# USEPOD_MAX_PAYMENT_LAMPORTS=100000

# Price keeper (stoppage-price) — Pyth Hermes auth. Required since the
# Pyth Core upgrade (2026-08-26): get a key from Pyth Terminal (free
# trial tier) or ticks log "Hermes 401" and no new price contracts mint.
# PYTH_API_KEY=your-pyth-terminal-key
# HERMES_URL=https://pyth.dourolabs.app/hermes
